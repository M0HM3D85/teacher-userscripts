  const createIndexPanel = () => {
    let panel = document.getElementById(indexPanelId);
    if (panel) return panel;

    panel = document.createElement('section');
    panel.id = indexPanelId;
    panel.innerHTML = `
      <div class="${APP}-idx-head">
