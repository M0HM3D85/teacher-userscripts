    for (let i = 0; i < candidates.length; i += concurrency) {
      const batch = candidates.slice(i, i + concurrency);
      await Promise.all(batch.map(async row => {
        try {
          const resultUrl = await resolveIndexSingleResultLink(row, params);
          if (!resultUrl) return;
          const result