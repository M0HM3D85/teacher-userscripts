+            ) {
+                continue;
+            }
+
+            const qid = normalizeQid(columns[0] || '');
+
+            if (!qid) {
+                invalid++;
+                continue;
+            }
+
+            if (seen.has(qid)) {
+                duplicates++;
+                continue;
+            }
+
+            if (columns.length < 9) {
+                invalid++;
+                continue;
+            }
+
+            const title = clean(columns[1] || '');
+            const rawType = clean(columns[2] || '');
+            const type = normalizeType(rawType);
+
+            if (!title || !type) {
