+
+    function normalizeQid(value) {
+        const raw = westernDigits(
+            clean(value)
+                .toUpperCase()
+                .replace(/\s+/g, '')
+        );
+
+        const m = raw.match(/^Q0*(\d+)$/i);
+
+        if (!m) {
+            return '';
+        }
+
+        const n = Number(m[1]);
+
+        if (!Number.isInteger(n) || n < 1) {
+            return '';
+        }
+
+        return `Q${String(n).padStart(3, '0')}`;
+    }
+
+    function oldTestCorrectValue(value) {
+        const v = clean(value);
+        const c = canonical(v);
+
+        if (
+            !v ||
+            [
+                'غير محدد',
+                'غير معروف',
+                'غير متاح',
+                'لا يوجد',
+                'n a',
+                'na'
+            ].includes(c)
+        ) {
+            return '';
+        }
+
+        return normalizeLetter(v);
+    }
+
+    function oldTestSkillValue(value) {
+        const v = clean(value);
+        const c = canonical(v);
+
+        if (
+            !v ||
+            [
+                'غير مصنف',
+                'غير محدد',
+                'غير معروف'
+            ].includes(c)
+        ) {
+            return '';
+        }
+
+        return v;
+    }
+
+    function parseOldTestExtraction(raw) {
+        const lines = String(raw || '')
+            .replace(/^\uFEFF/, '')
+            .replace(/\r\n?/g, '\n')
+            .split('\n');
+
+        const items = [];
+        const seen = new Set();
+        let duplicates = 0;
+        let invalid = 0;
+
+        for (const originalLine of lines) {
