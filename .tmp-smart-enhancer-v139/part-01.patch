+              ? row.answers
+              : [];
+
+          answers.forEach(
+            (answer, position) => {
+              const id =
+                answerQuestionId(
+                  answer
+                );
+
+              const value =
+                answerTextValue(
+                  answer
+                );
+
+              if (
+                !id ||
+                !value
+              ) {
+                return;
+              }
+
+              if (
+                !groups.has(
+                  id
+                )
